# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Chat ID to send alerts (get from @userinfobot)
CHAT_ID=your_chat_id_here

# Price check interval in seconds (default: 30)
CHECK_INTERVAL=30

# High price levels to alert on
HIGH_LEVELS=[0.38,0.40,0.45,0.50]

# Low price levels to alert on
LOW_LEVELS=[0.35,0.34,0.33,0.32,0.30]
